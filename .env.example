# Copy to .env (git-ignored) or export these in the server environment.
# Generate a key: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=your-domain.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example.com
# Turn on once the site is served over HTTPS (secure cookies, redirect, HSTS):
# DJANGO_HTTPS=1
# Set when running behind a proxy that sets X-Forwarded-Proto (nginx, Cloudflare, ...):
# DJANGO_BEHIND_PROXY=1
# Optional: absolute path of the SQLite file (keep it outside the code directory, and back it up).
# DJANGO_DB_PATH=/var/lib/fin-track/db.sqlite3
# Local development only:
# DJANGO_DEBUG=1
